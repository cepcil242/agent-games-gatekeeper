# Copy to .env (or set in your host's environment) and fill in real values.
# NEVER commit a filled .env, and never paste secrets into a chat.

# The platform-generated HMAC secret: dashboard -> Rotate Secret (shown once).
AGENT_GAMES_HMAC_SECRET=

# Optional: Kurier (zkVerify) mainnet API key for background proof submission.
KURIER_API_KEY=

# Port and registered handler path (the platform posts to the URL exactly as
# registered — register the full path, e.g. https://your-host.example/agent).
PORT=8080
AGENT_PATH=/agent

# Where the official circuit artifacts live (gatekeeper.wasm,
# gatekeeper_final.zkey). Defaults to ../circuits next to this app.
CIRCUITS_DIR=
